# Kopiraj u deploy/.env (van gita) i popuni. FTP_* i DEPLOY_* se koriste samo za deploy,
# sve ostalo postaje backend .env na serveru.

FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
# Putanje relativne na FTP koren naloga (home folder), npr. evidencija_app i evidencija.fiskultura.rs
DEPLOY_APP_DIR=evidencija_app
DEPLOY_WEB_DIR=evidencija.fiskultura.rs
# Nasumičan string: php -r "echo bin2hex(random_bytes(32));"
DEPLOY_SECRET=

APP_NAME="Evidencija FV"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://evidencija.fiskultura.rs
APP_LOCALE=sr
APP_TIMEZONE=Europe/Belgrade

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PREFIX=efv_

JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=365

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
